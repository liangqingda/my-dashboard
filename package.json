{
  "name": "my-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "bash scripts/auto-start.sh",
    "stop": "node scripts/stop-local.mjs all",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "lint": "eslint . && node scripts/check-structure.mjs && liangqingda-check-scss src && node scripts/check-imports.mjs && pnpm check:md",
    "check:md": "node --experimental-strip-types scripts/md-roundtrip.mts",
    "component:new": "node scripts/new-component.mjs",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "node --test agent/*.test.mjs && node --experimental-strip-types --test tests/unit/*.test.mts",
    "test:e2e": "playwright test",
    "check:structure": "node scripts/check-structure.mjs",
    "check:scss": "liangqingda-check-scss src",
    "check:imports": "node scripts/check-imports.mjs"
  },
  "dependencies": {
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@mantine/notifications": "^9.7.2",
    "@tabler/icons-react": "^3.45.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "^8.2.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@liangqingda/eslint-config": "^1.7.0",
    "@liangqingda/tsconfig": "^1.1.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "prettier": "^3.9.5",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  }
}
