{
  "name": "my-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:bg": "nohup vite > /tmp/my-dashboard-dev.log 2>&1 &",
    "stop:dev": "kill $(pgrep -f 'vite/bin/vite.js$') 2>/dev/null && echo 'Dev server stopped' || echo 'No dev server running'",
    "agent": "node agent/server.mjs",
    "agent:bg": "nohup node agent/server.mjs > /tmp/my-dashboard-agent.log 2>&1 &",
    "agent:stop": "kill $(pgrep -f 'agent/server.mjs') 2>/dev/null && echo 'Agent stopped' || echo 'No agent running'",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "lint": "eslint . && node scripts/check-features.mjs",
    "check:features": "node scripts/check-features.mjs",
    "feature:new": "node scripts/new-feature.mjs",
    "component:new": "node scripts/new-component.mjs",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@tabler/icons-react": "^3.45.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0"
  },
  "devDependencies": {
    "@liangqingda/eslint-config": "^1.3.0",
    "@liangqingda/tsconfig": "^1.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "prettier": "^3.9.5",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  }
}
